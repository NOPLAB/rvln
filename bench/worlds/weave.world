<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <shadows>false</shadows>
    </scene>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>20</update_rate>
    </plugin>
    <model name="left_block">
      <static>true</static>
      <pose>1.0 0.25 0.3 0 0 0</pose>
      <link name="body">
        <visual name="box">
          <geometry>
            <box>
              <size>0.4 0.55 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
        <collision name="box">
          <geometry>
            <box>
              <size>0.4 0.55 0.6</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="right_block">
      <static>true</static>
      <pose>1.9 -0.25 0.3 0 0 0</pose>
      <link name="body">
        <visual name="box">
          <geometry>
            <box>
              <size>0.4 0.55 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
        <collision name="box">
          <geometry>
            <box>
              <size>0.4 0.55 0.6</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="red_marker">
      <static>true</static>
      <pose>3.2 0.0 0.35 0 0 0</pose>
      <link name="body">
        <visual name="box">
          <geometry>
            <box>
              <size>0.25 0.25 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.05 0.05 1</ambient>
            <diffuse>0.9 0.05 0.05 1</diffuse>
          </material>
        </visual>
        <collision name="box">
          <geometry>
            <box>
              <size>0.25 0.25 0.7</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
