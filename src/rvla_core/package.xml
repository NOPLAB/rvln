<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rvla_core</name>
  <version>0.1.0</version>
  <description>ROS-free OmniVLA-edge inference core shared by the edge (Pi) and remote (Jetson/cloud) stacks.</description>
  <maintainer email="noplab90@gmail.com">nop</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Deliberately no ROS runtime deps: this package must stay importable in
       the ROS-free remote server containers. torch / clip / efficientnet are
       lazy-imported by the engine and provided by the Docker images. -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
