<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>raspicat_vla_remote</name>
  <version>0.1.0</version>
  <description>ROS 2 inference node for dummy, AsyncVLA, OmniVLA and movla backends.</description>
  <maintainer email="nop@example.com">nop</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>raspicat_vla_msgs</exec_depend>
  <!-- Path 3 (omnivla_edge backend) reuses the ROS-free OmniVLAEdgeEngine from
       the shared core package. Only used when the omnivla_edge backend is selected. -->
  <exec_depend>raspicat_vla_core</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
