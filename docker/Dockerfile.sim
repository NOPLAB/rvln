# RVLN inference overlay on the standalone usim Gazebo runtime.
ARG USIM_GAZEBO_IMAGE=usim-gazebo:local
FROM ${USIM_GAZEBO_IMAGE}

# Build and inference dependencies are RVLN-owned, not inherited from usim.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git wget python3-pip python3-colcon-common-extensions python3-rosdep \
        python3-vcstool python3-numpy python3-opencv python3-pil \
        ros-humble-cv-bridge ros-humble-diagnostic-msgs \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir 'setuptools==59.6.0'

# RVLN owns Raspicat; the standalone usim base stays robot-independent.
COPY raspicat.repos /tmp/raspicat.repos
RUN mkdir -p /opt/sim_ws/src \
    && vcs import /opt/sim_ws/src < /tmp/raspicat.repos \
    && rm /tmp/raspicat.repos
RUN if [ -f /opt/sim_ws/src/raspicat_sim/raspicat_gazebo/scripts/download_gazebo_models.sh ]; then \
        bash /opt/sim_ws/src/raspicat_sim/raspicat_gazebo/scripts/download_gazebo_models.sh; \
    fi
RUN apt-get update \
    && rosdep update \
    && rosdep install -r -y --from-paths /opt/sim_ws/src --ignore-src --rosdistro humble \
    && rm -rf /var/lib/apt/lists/*
RUN cd /opt/sim_ws \
    && source /opt/ros/humble/setup.bash \
    && colcon build --symlink-install --merge-install \
    && chmod -R a+rX /opt/sim_ws

# --------------------------------------------------------------- python deps
# CPU-only torch (sim runs on a workstation/laptop, not the GPU box).
RUN pip3 install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        'torch==2.2.0' 'torchvision==0.17.0' \
    && pip3 install --no-cache-dir \
        'numpy<2' \
        'efficientnet_pytorch>=0.7.1' \
        'einops' \
        'opencv-python-headless' \
        'grpcio>=1.50' \
        'grpcio-tools>=1.50' \
        'protobuf>=4.21'

# Pin setuptools to the ROS2 Humble default. colcon's `--symlink-install` runs
# `setup.py develop --editable` for ament_python packages (rvln_proto/
# remote/edge), which setuptools>=80 has removed; and setuptools>=66 paired with
# Ubuntu's apt packaging 21.3 breaks ament_cmake_python egg builds via
# `canonicalize_version(strip_trailing_zero=...)`. 59.6.0 avoids both. Keep this
# AFTER the torch/grpcio installs so it wins as the final setuptools.
RUN pip3 install --no-cache-dir 'setuptools==59.6.0'

# edge_action_ws_node (Web/スマホ -> Pi の action chunk WS ブリッジ)。
RUN pip3 install --no-cache-dir 'websockets>=10'

# ---------------------------------------------- AsyncVLA edge inference deps
# Vendor only the prismatic source (training deps NOT installed). Stub the
# heavy __init__ files so `from prismatic.models.small_head import Edge_adapter`
# succeeds without pulling transformers / draccus / peft / etc.
COPY external/AsyncVLA/prismatic      /opt/AsyncVLA/prismatic
# Stub every prismatic.* __init__ file that imports training-time deps
# (transformers / draccus / peft / etc.). Keep submodules' .py importable but
# don't run their __init__ chains. This is enough for `from
# prismatic.models.small_head import Edge_adapter` and `from
# prismatic.vla.constants import ACTION_DIM` to succeed on a CPU-only image.
RUN : > /opt/AsyncVLA/prismatic/__init__.py \
    && : > /opt/AsyncVLA/prismatic/models/__init__.py \
    && : > /opt/AsyncVLA/prismatic/conf/__init__.py \
    && : > /opt/AsyncVLA/prismatic/vla/__init__.py \
    && chmod -R a+rX /opt/AsyncVLA

COPY external/MBRA                    /opt/MBRA
RUN chmod -R a+rX /opt/MBRA

ENV PYTHONPATH=/opt/AsyncVLA:/opt/MBRA/train

# ---------------------------------------------- shell entry
RUN echo "source /opt/ros/humble/setup.bash" >> /etc/bash.bashrc \
    && echo "source /opt/sim_ws/install/setup.bash" >> /etc/bash.bashrc \
    && echo '[[ -f /workspace/install/setup.bash ]] && source /workspace/install/setup.bash' >> /etc/bash.bashrc

WORKDIR /workspace
CMD ["/bin/bash"]
